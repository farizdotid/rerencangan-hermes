# Copy to .env and adjust. Never commit .env.
# Host the server binds to. Keep 127.0.0.1; use an SSH tunnel for remote access.
HOST=127.0.0.1
# Port for the API/SSE server.
PORT=9600
# Data mode for "npm run server": "demo" (fake data, default) or "real"
# (read-only Hermes CLI collector). "npm start" always uses real mode and
# "npm run demo" always uses demo mode, whatever this says.
# MODE=demo
# Real mode only: path to the hermes executable. Default: "hermes" on PATH.
# HERMES_BIN=/absolute/path/to/hermes
